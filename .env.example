# Copy this file to .env and fill in what you need. Everything is optional.
# SerpApi key from https://serpapi.com/manage-api-key (or put it alone in a file named serpapi.key)
SERPAPI_KEY=
# serpapi | demo  (default: serpapi when a key is found, else demo)
DELTAMAP_PROVIDER=
# DL (Delta-marketed only) or SKYTEAM (then keep itineraries with a Delta flight)
AIRLINE_FILTER=DL
# Ask before searching when fewer than this many searches are left
LOW_QUOTA_WARN=20
